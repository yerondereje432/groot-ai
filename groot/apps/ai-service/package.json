{
  "name": "@groot/ai-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@groot/shared-types": "*",
    "fastify": "^4.27.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "ioredis": "^5.4.1",
    "pg": "^8.12.0",
    "zod": "^3.23.8",
    "pino": "^9.2.0",
    "pino-pretty": "^11.2.1",
    "nanoid": "^5.0.7"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0"
  }
}
