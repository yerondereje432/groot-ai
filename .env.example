# =============================================================
# GROOT — Unified Environment Template
# =============================================================

# --- AI PROVIDERS ---
# Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Set these to "gemini" once GEMINI_API_KEY above is filled in — they default to
# "stub" (no external calls, deterministic dev behavior) if left unset.
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
# LLM-based re-ranking (§14) via Gemini instead of the lexical-overlap stub.
RERANKER_PROVIDER=gemini
# Skip the LLM-rerank call when the top pre-rerank score already clears this
# (saves a Gemini round-trip + tokens on obvious matches). 0..1, default 0.92.
# RERANK_SKIP_THRESHOLD=0.92

# 'redis' shares the retrieval cache across ai-service replicas (required once
# you run more than one instance); falls back to 'memory' automatically if
# Redis is unreachable at boot. Default 'memory' (fine for a single instance).
# CACHE_PROVIDER=redis

# --- BACKEND (NestJS) ---
PORT=3000
DATABASE_URL="postgresql://groot:groot_dev_password@localhost:5432/groot?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="groot_development_only_secret_change_in_prod"

# --- SMS OTP delivery ---
# 'console' (default) just logs the OTP to stdout — fine for local dev, but a
# hard launch blocker in production since no SMS is actually sent. Set to
# 'twilio' or 'http' with real credentials before going live.
SMS_PROVIDER=console
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
# SMS_GATEWAY_URL=
# SMS_GATEWAY_API_KEY=

# --- AI SERVICE (TypeScript) ---
AI_SERVICE_PORT=3001
AI_SERVICE_URL="http://localhost:3001"

# --- FRONTEND (Next.js) ---
# Points to the NestJS API
NEXT_PUBLIC_BACKEND_URL="http://localhost:3000/api/v1"
# Points to your Supabase project (if using Supabase Auth)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
