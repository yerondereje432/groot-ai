{
  "name": "groot",
  "version": "0.1.0",
  "private": true,
  "description": "Groot — Curriculum-locked AI tutor for Ethiopian high-school students (Grades 9–12)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "dev:api": "npm run dev --workspace apps/api",
    "dev:ai": "npm run dev --workspace apps/ai-service",
    "dev:ingestion": "npm run dev --workspace apps/ingestion-worker",
    "dev:web": "npm run dev --workspace @groot/web",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:ai\" \"npm run dev:web\" \"npm run dev:ingestion\"",
    "up": "docker compose up -d",
    "down": "docker compose down",
    "logs": "docker compose logs -f",
    "db:migrate": "npm run db:migrate --workspace apps/api",
    "db:seed": "npm run db:seed --workspace apps/api",
    "ingest:sample": "npm run ingest:sample --workspace apps/ingestion-worker",
    "eval": "npm run eval --workspace apps/ai-service"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5"
  }
}
