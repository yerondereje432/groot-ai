    "pino-pretty": "^11.2.1",
    "zod": "^3.23.8",
    "pdf-parse": "^1.1.1"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.6",
    "tsx": "^4.11.0",
    "vitest": "^1.6.0"
  }
